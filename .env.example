# Copy this file to .env and fill in your values:
#   cp .env.example .env
# .env is in .gitignore, so your key never goes to GitHub.

# Required: Google Places API (New) key
GOOGLE_MAPS_API_KEY=your-google-api-key-here

# Optional defaults (command-line options override these)
LOCATION=Your City
LAT=
LNG=
RADIUS=5000
GRID=1
# Comma-separated; leave empty to use the built-in list of 18 categories
CATEGORIES=

# MongoDB (local)
MONGO_URI=mongodb://localhost:27017
MONGO_DB=business_leads

# Web app
PORT=5000
# Country code added to 10-digit numbers for WhatsApp links
COUNTRY_CODE=91

# Gemini (for WhatsApp proposal messages) - get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Comma-separated: if the first model is busy (503/429) the next one is tried
GEMINI_MODEL=gemini-3.8-flash,gemini-flash-lite-latest
# Who the proposal is from, e.g. "Ashutosh, web developer in Gorakhpur" (optional)
PROPOSAL_FROM=
